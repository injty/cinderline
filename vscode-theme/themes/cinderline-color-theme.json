  "tokenColors": [
    {
      "name": "comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#B0B0B0",
        "fontStyle": ""
      }
    },
    {
      "name": "string",
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#A7B89F"
      }
    },
    {
      "name": "string.regex",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#DD9387"
      }
    },
    {
      "name": "string.escape",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#DD9387"
      }
    },
    {
      "name": "string.special.symbol",
      "scope": [
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#DD9387"
      }
    },
    {
      "name": "number",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#DD9387"
      }
    },
    {
      "name": "boolean",
      "scope": [
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#DD9387"
      }
    },
    {
      "name": "constant",
      "scope": [
        "constant"
      ],
      "settings": {
        "foreground": "#DD9387"
      }
    },
    {
      "name": "constant.builtin",
      "scope": [
        "constant.language"
      ],
      "settings": {
        "foreground": "#DD9387"
      }
    },
    {
      "name": "keyword",
      "scope": [
        "keyword",
        "storage",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#D99565"
      }
    },
    {
      "name": "operator",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#B0B0B0"
      }
    },
    {
      "name": "preproc",
      "scope": [
        "meta.preprocessor",
        "keyword.control.directive"
      ],
      "settings": {
        "foreground": "#D99565"
      }
    },
    {
      "name": "type",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "storage.type.support"
      ],
      "settings": {
        "foreground": "#DD9387"
      }
    },
    {
      "name": "type.builtin",
      "scope": [
        "support.type",
        "support.class",
        "storage.type.primitive"
      ],
      "settings": {
        "foreground": "#DD9387"
      }
    },
    {
      "name": "enum",
      "scope": [
        "variable.other.enummember",
        "entity.name.type.enum"
      ],
      "settings": {
        "foreground": "#DD9387"
      }
    },
    {
      "name": "function",
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function",
        "meta.function-call.generic"
      ],
      "settings": {
        "foreground": "#CCCCCC"
      }
    },
    {
      "name": "constructor",
      "scope": [
        "entity.name.function.constructor"
      ],
      "settings": {
        "foreground": "#DD9387"
      }
    },
    {
      "name": "property",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#CCCCCC"
      }
    },
    {
      "name": "property.json_key",
      "scope": [
        "support.type.property-name.json",
        "string.json",
        "support.type.property-name.toml",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#CCCCCC"
      }
    },
    {
      "name": "variable",
      "scope": [
        "variable"
      ],
      "settings": {
        "foreground": "#D6D6D6"
      }
    },
    {
      "name": "variable.parameter",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#CCCCCC"
      }
    },
    {
      "name": "variable.special",
      "scope": [
        "variable.language"
      ],
      "settings": {
        "foreground": "#DD9387"
      }
    },
    {
      "name": "namespace",
      "scope": [
        "entity.name.namespace",
        "entity.name.module"
      ],
      "settings": {
        "foreground": "#CCCCCC"
      }
    },
    {
      "name": "attribute",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#CCCCCC"
      }
    },
    {
      "name": "selector",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.name.tag.css"
      ],
      "settings": {
        "foreground": "#CCCCCC"
      }
    },
    {
      "name": "selector.pseudo",
      "scope": [
        "entity.other.attribute-name.pseudo-class.css",
        "entity.other.attribute-name.pseudo-element.css"
      ],
      "settings": {
        "foreground": "#CCCCCC"
      }
    },
    {
      "name": "tag",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#D99565"
      }
    },
    {
      "name": "tag.doctype",
      "scope": [
        "meta.tag.sgml.doctype"
      ],
      "settings": {
        "foreground": "#B0B0B0"
      }
    },
    {
      "name": "punctuation",
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#B0B0B0"
      }
    },
    {
      "name": "punctuation.special",
      "scope": [
        "punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#DD9387"
      }
    },
    {
      "name": "punctuation.list_marker",
      "scope": [
        "punctuation.definition.list"
      ],
      "settings": {
        "foreground": "#D99565"
      }
    },
    {
      "name": "punctuation.markup",
      "scope": [
        "punctuation.definition.heading",
        "punctuation.definition.quote"
      ],
      "settings": {
        "foreground": "#D99565"
      }
    },
    {
      "name": "embedded",
      "scope": [
        "meta.embedded",
        "source.embedded"
      ],
      "settings": {
        "foreground": "#D6D6D6"
      }
    },
    {
      "name": "title",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#D99565",
        "fontStyle": "bold"
      }
    },
    {
      "name": "emphasis",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#D6D6D6",
        "fontStyle": "italic"
      }
    },
    {
      "name": "emphasis.strong",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#D6D6D6",
        "fontStyle": "bold"
      }
    },
    {
      "name": "link_text",
      "scope": [
        "string.other.link.title",
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#D6D6D6"
      }
    },
    {
      "name": "link_uri",
      "scope": [
        "markup.underline.link.image",
        "meta.link.inline.markdown",
        "markup.underline.link.markdown"
      ],
      "settings": {
        "foreground": "#CCCCCC"
      }
    },
    {
      "name": "text.literal",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#A7B89F"
      }
    },
    {
      "name": "diff.plus",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#A7B89F"
      }
    },
    {
      "name": "diff.minus",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#DD9387"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "variable": "#D6D6D6",
    "variable.readonly": "#DD9387",
    "variable.defaultLibrary": "#DD9387",
    "parameter": "#CCCCCC",
    "property": "#CCCCCC",
    "function": "#CCCCCC",
    "method": "#CCCCCC",
    "class": "#DD9387",
    "interface": "#DD9387",
    "type": "#DD9387",
    "typeParameter": "#DD9387",
    "struct": "#DD9387",
    "enum": "#DD9387",
    "enumMember": "#DD9387",
    "namespace": "#CCCCCC",
    "decorator": "#CCCCCC",
    "macro": "#D99565",
    "keyword": "#D99565",
    "modifier": "#D99565",
    "operator": "#B0B0B0",
    "string": "#A7B89F",
    "regexp": "#DD9387",
    "number": "#DD9387",
    "comment": "#B0B0B0"
  }
}
