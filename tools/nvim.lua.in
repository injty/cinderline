-- Generated by tools/build.py from palette.json and tools/nvim.lua.in.
vim.o.background = "dark"
vim.cmd("highlight clear")
vim.g.colors_name = "cinderline"

local p = {
$palette
}

local groups = {
  Normal = { fg = p.text, bg = p.editor },
  Cursor = { fg = p.editor, bg = p.orange },
  CursorLine = { bg = p.surface },
  CursorLineNr = { fg = p.orange, bold = true },
  LineNr = { fg = p.text_disabled },
  SignColumn = { fg = p.text_disabled, bg = p.editor },
  NonText = { fg = p.invisible },
  EndOfBuffer = { fg = p.divider },
  ColorColumn = { bg = p.surface },
  Folded = { fg = p.text_muted, bg = p.surface },
  WinSeparator = { fg = p.divider },
  StatusLine = { fg = p.text, bg = p.base },
  StatusLineNC = { fg = p.text_muted, bg = p.base },
  TabLineSel = { fg = p.orange, bg = p.editor, bold = true },
  NormalFloat = { fg = p.text, bg = p.elevated },
  FloatBorder = { fg = p.border, bg = p.elevated },
  PmenuSel = { fg = p.text, bg = p.selected, bold = true },
  PmenuSbar = { bg = p.surface },
  PmenuThumb = { bg = p.border },
  NeoTreeNormal = { fg = p.text, bg = p.base },
  NeoTreeCursorLine = { bg = p.selected },
  NeoTreeGitRenamed = { fg = p.renamed },
  NeoTreeGitConflict = { fg = p.conflict },
  NeoTreeGitIgnored = { fg = p.ignored },

  -- Neovim needs opaque backgrounds; build.py composites overlays onto editor.
  Visual = { bg = p.selection },
  Search = { fg = p.text, bg = p.search },
  CurSearch = { fg = p.text, bg = p.search_active, bold = true },
  MatchParen = { bg = p.selection, bold = true },
  LspReferenceRead = { bg = p.read_highlight },
  LspReferenceWrite = { bg = p.write_highlight },
  DiffAdd = { bg = p.diff_add_line },
  DiffDelete = { fg = p.deleted, bg = p.diff_delete_line },
  DiffChange = { bg = p.diff_change_line },
  DiffText = { fg = p.modified, bg = p.border, bold = true },
  GitSignsAddInline = { bg = p.diff_add_word },
  GitSignsDeleteInline = { bg = p.diff_delete_word },

  Identifier = { fg = p.text },
  Comment = { fg = p.comment },
  Operator = { fg = p.operator },
  Delimiter = { fg = p.text_muted },
  Function = { fg = p.callable },
  ["@function.builtin"] = { fg = p.brushed_bronze },
  String = { fg = p.string },
  Constant = { fg = p.constant },
  Number = { fg = p.literal },
  Type = { fg = p.type },
  ["@type.builtin"] = { fg = p.amber },
  ["@keyword.modifier"] = { fg = p.peach },
  Property = { fg = p.property },
  Attribute = { fg = p.attribute },
  Parameter = { fg = p.parameter },
  Namespace = { fg = p.namespace },
  SpecialChar = { fg = p.escape },
  ["@string.regexp"] = { fg = p.regex },
  Statement = { fg = p.keyword },
  Title = { fg = p.orange, bold = true },
  Todo = { fg = p.orange, bold = true },
  Underlined = { fg = p.callable, underline = true },
  Italic = { fg = p.linen, italic = false },
  ["@markup.strong"] = { bold = true },
  ["@markup.strikethrough"] = { strikethrough = true },
  LspInlayHint = { fg = p.hint, bg = p.surface },
  Added = { fg = p.added },
  Changed = { fg = p.modified },
  Removed = { fg = p.deleted },
}

-- Standard syntax, Tree-sitter captures and LSP semantic tokens share roles.
local aliases = {
  Cursor = { "lCursor", "TermCursor" },
  CursorLine = { "CursorColumn" },
  NonText = { "Whitespace", "SpecialKey" },
  SignColumn = { "FoldColumn" },
  StatusLineNC = { "TabLine", "TabLineFill" },
  NormalFloat = { "Pmenu" },
  PmenuSel = { "WildMenu" },
  CurSearch = { "IncSearch" },
  LspReferenceRead = { "LspReferenceText" },
  NeoTreeNormal = { "NeoTreeNormalNC", "NeoTreeSignColumn" },
  NeoTreeGitIgnored = { "NeoTreeIgnored" },
  Identifier = { "@variable", "@lsp.type.variable", "NeoTreeFileName", "NeoTreeDirectoryName" },
  Italic = { "@markup.italic", "htmlItalic", "markdownItalic" },
  Delimiter = { "@punctuation", "@tag.delimiter" },
  Function = { "@function", "@function.method", "@lsp.type.function", "@lsp.type.method", "@markup.link.label" },
  ["@function.builtin"] = { "@lsp.typemod.function.defaultLibrary", "@lsp.typemod.method.defaultLibrary" },
  Constant = { "@constant", "@lsp.typemod.variable.readonly" },
  Property = { "@property", "@variable.member", "@lsp.type.property", "@lsp.typemod.property.readonly",
               "@string.special.key.json", "@string.special.key.jsonc" },
  Attribute = { "@attribute", "@tag.attribute" },
  Parameter = { "@variable.parameter", "@lsp.type.parameter" },
  Namespace = { "@module", "@lsp.type.namespace", "@lsp.type.decorator" },
  Type = { "@type", "@constructor", "@lsp.type.class", "@lsp.type.enum", "@lsp.type.struct",
           "@lsp.type.interface", "@lsp.type.type", "@lsp.type.typeParameter" },
  ["@type.builtin"] = { "PreProc", "@function.macro", "@constant.macro", "@lsp.type.macro" },
  Operator = { "@keyword.operator" },
  SpecialChar = { "@string.escape", "@punctuation.special", "@string.special" },
  Number = {
    "Boolean", "Float", "Special", "@variable.builtin", "@constant.builtin",
    "@string.special.symbol", "@lsp.type.enumMember",
  },
  Statement = { "Keyword", "@tag", "@markup.list", "Directory", "ModeMsg", "Question" },
  String = { "Character", "@markup.raw" },
  Title = { "@markup.heading", "FloatTitle" },
  Underlined = { "@markup.link.url" },
  Added = { "GitSignsAdd", "diffAdded", "@diff.plus", "NeoTreeGitAdded", "NeoTreeGitUntracked" },
  Changed = { "GitSignsChange", "diffChanged", "@diff.delta", "NeoTreeGitModified", "NeoTreeModified" },
  Removed = { "GitSignsDelete", "diffRemoved", "@diff.minus", "NeoTreeGitDeleted" },
  DiagnosticError = { "Error", "ErrorMsg", "@comment.error" },
  DiagnosticWarn = { "WarningMsg", "@comment.warning", "@comment.todo" },
  DiagnosticInfo = { "@comment.note" },
}

for severity, color in pairs({
  Error = p.error, Warn = p.warning, Info = p.info, Hint = p.hint, Ok = p.success,
}) do
  groups["Diagnostic" .. severity] = { fg = color }
  groups["DiagnosticUnderline" .. severity] = { sp = color, undercurl = true }
end

for name, style in pairs(groups) do
  vim.api.nvim_set_hl(0, name, style)
end
for target, names in pairs(aliases) do
  for _, name in ipairs(names) do
    vim.api.nvim_set_hl(0, name, { link = target })
  end
end

local ansi = {
$ansi
}
for i, color in ipairs(ansi) do
  vim.g["terminal_color_" .. (i - 1)] = color
end
